# Database migration configuration for Elastic Beanstalk
# Runs migrations on deployment if MIGRATE_ON_DEPLOY is set to true

option_settings:
  aws:elasticbeanstalk:application:environment:
    MIGRATE_ON_DEPLOY: "true"
    DATABASE_SSL: "true"

container_commands:
  01_run_migrations:
    command: |
      if [ "$MIGRATE_ON_DEPLOY" = "true" ]; then
        echo "Running database migrations..."
        npm run migrate || echo "Migration failed or already applied"
      else
        echo "Skipping database migrations (MIGRATE_ON_DEPLOY not set)"
      fi
    leader_only: true
