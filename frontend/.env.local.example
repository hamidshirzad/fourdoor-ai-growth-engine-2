# Origin of the Express API (backend/). Required.
#
# The API is a separate service on a separate origin — it is never same-origin
# with this frontend, so there is no sensible default to fall back to. When this
# is unset, lib/api.js reports the missing configuration and the login page
# disables itself, rather than posting to this site where /api/auth/login does
# not exist.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time. Setting
# this in a hosting dashboard after a build changes nothing until the site is
# rebuilt — on Netlify use "Clear cache and deploy site", on Vercel redeploy.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional. Browser Supabase client (lib/supabase.js), reserved for future
# realtime/storage features. The client is null when these are unset, which is
# fine — app authentication runs on the Express backend (JWT + WorkOS SSO), not
# Supabase Auth.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
