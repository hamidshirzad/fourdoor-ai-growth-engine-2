# Auth0 Deploy CLI credentials — OPS TOOLING ONLY.
#
# These are NOT read by the backend or the frontend. They authenticate the
# a0deploy CLI against the Auth0 Management API so it can read and write tenant
# configuration. Copy to auth0/.env.auth0 (gitignored) and fill in.
#
#   cp auth0/.env.auth0.example auth0/.env.auth0
#
# IMPORTANT: these must come from a dedicated Machine-to-Machine application
# authorized against the Auth0 Management API — NOT from the regular web/SPA
# application that the Netlify Auth0 extension creates. See auth0/README.md.
#
# NAME COLLISION WARNING: the Netlify Auth0 extension injects AUTH0_DOMAIN and
# AUTH0_CLIENT_ID into the *site* build environment for the runtime app. Those
# are a different application with no Management API grants. If you run the
# Deploy CLI somewhere those are already set, it will try to authenticate as the
# SPA client and fail with an authorization error.

# Tenant domain, e.g. dev-sfv34zclvdf4noih.auth0.com
AUTH0_DOMAIN=

# Client id / secret of the dedicated M2M application.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Destructive-operation switch. Leave false unless you specifically intend for
# an import to DELETE tenant resources that are absent from the repo config.
AUTH0_ALLOW_DELETE=false
