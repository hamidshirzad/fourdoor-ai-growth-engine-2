# --- Required for a working production deployment -------------------------
# NEXT_PUBLIC_API_URL  (frontend) full origin of the deployed backend, e.g.
#                      https://fourdoor-api.up.railway.app. The frontend is a
#                      separate Vercel project from the API, so without this
#                      every call 404s against Vercel and login fails.
# DATABASE_URL         (backend)  PostgreSQL connection string. The API now
#                      refuses to start without it instead of silently using an
#                      in-memory database that loses every write on restart.
# JWT_SECRET           (backend)  >= 32 random characters.
# CORS_ORIGIN          (backend)  comma-separated list of allowed origins,
#                      e.g. https://www.fourdoorai.com,https://fourdoorai.com
# ---------------------------------------------------------------------------

AGENT_LOGS_RETENTION_DAYS=
AIKIDO_API_BASE_URL=
AIKIDO_API_KEY=
ALLOW_IN_MEMORY_DB=
AWS_ACCOUNT_ID=
AWS_REGION=
CALENDLY_API_TOKEN=
CALENDLY_BOOKING_URL=
CALENDLY_USER_URI=
CONTENT_CRON=
CORS_ORIGIN=
DATABASE_SSL=
DATABASE_URL=
DB_PASSWORD=
DB_USERNAME=
DISABLE_SCHEDULERS=
DYNAMODB_AGENT_LOGS_TABLE=
ENVIRONMENT=
FRONTEND_URL=
GEMINI_API_KEY=
JWT_EXPIRES_IN=
JWT_SECRET=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPTIMIZATION_CRON=
PAYPAL_AGENCY_PLAN_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=
PAYPAL_PRO_PLAN_ID=
PAYPAL_STARTER_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PROJECT_NAME=
PUBLISH_CRON=
RATE_LIMIT_PER_MINUTE=
SECURITY_SCAN_BATCH_SIZE=
SECURITY_SCAN_CRON=
SECURITY_SCAN_LOOKBACK_DAYS=
# Stripe subscriptions. Checkout is hosted by Stripe, so no publishable key is
# needed in the browser. Price ids come from the Stripe dashboard (Products ->
# pricing), and STRIPE_WEBHOOK_SECRET from the webhook endpoint you register at
# <backend-url>/api/billing/stripe/webhook. Without the webhook secret no
# subscription can ever activate — activation happens only on a verified event.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_ORGANIZATION_ID=
WORKOS_REDIRECT_URI=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=
