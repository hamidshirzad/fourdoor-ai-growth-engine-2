# --- Required for a working production deployment -------------------------
# NEXT_PUBLIC_API_URL  (frontend) full origin of the deployed backend, e.g.
#                      https://fourdoor-api.up.railway.app. The frontend is a
#                      separate Vercel project from the API, so without this
#                      every call 404s against Vercel and login fails.
# DATABASE_URL         (backend)  PostgreSQL connection string. The API now
#                      refuses to start without it instead of silently using an
#                      in-memory database that loses every write on restart.
# JWT_SECRET           (backend)  >= 32 random characters.
# CORS_ORIGIN          (backend)  comma-separated list of allowed origins,
#                      e.g. https://www.fourdoorai.com,https://fourdoorai.com
# ---------------------------------------------------------------------------

AGENT_LOGS_RETENTION_DAYS=
AIKIDO_API_BASE_URL=
AIKIDO_API_KEY=
ALLOW_IN_MEMORY_DB=
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_WORKER_BATCH_SIZE=5
AUTOMATION_WORKER_POLL_MS=30000
AUTOMATION_WORKER_STALE_LOCK_MINUTES=30
AUTOMATION_LEAD_FOLLOW_UP_LIMIT=5
AUTOMATION_WORKER_ID=
AWS_ACCOUNT_ID=
AWS_REGION=
CALENDLY_API_TOKEN=
CALENDLY_BOOKING_URL=
CALENDLY_USER_URI=
CONTENT_CRON=
CORS_ORIGIN=
DATABASE_SSL=
DATABASE_URL=
DB_PASSWORD=
DB_USERNAME=
DISABLE_SCHEDULERS=
DYNAMODB_AGENT_LOGS_TABLE=
ENVIRONMENT=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Shared HMAC secret used only between Fourdooraiops and this backend.
# Generate at least 32 random bytes and configure the identical value on both
# services. Never expose it to a browser or VITE_/NEXT_PUBLIC_ variable.
FOURDOOR_INTERNAL_SHARED_SECRET=
FRONTEND_URL=
GEMINI_API_KEY=
JWT_EXPIRES_IN=
JWT_SECRET=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPTIMIZATION_CRON=
PAYPAL_AGENCY_PLAN_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=
PAYPAL_PRO_PLAN_ID=
PAYPAL_STARTER_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PROJECT_NAME=
PUBLISH_CRON=
RATE_LIMIT_PER_MINUTE=
SECURITY_SCAN_BATCH_SIZE=
SECURITY_SCAN_CRON=
SECURITY_SCAN_LOOKBACK_DAYS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_ORGANIZATION_ID=
WORKOS_REDIRECT_URI=
