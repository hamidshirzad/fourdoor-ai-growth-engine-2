{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 255 },
        "email": { "type": "string", "format": "email", "maxLength": 255 },
        "company": { "type": "string", "maxLength": 255 },
        "plan": { "type": "string", "maxLength": 64 },
        "subscription_status": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Captured and qualified leads",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 255 },
        "email": { "type": "string", "format": "email", "maxLength": 255 },
        "company": { "type": "string", "maxLength": 255 },
        "source": { "type": "string", "maxLength": 64 },
        "score": { "type": "number" },
        "status": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "System activity logs for automated actions",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "agent": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 255 },
        "status": { "type": "string", "maxLength": 64 },
        "input": { "type": "string", "maxLength": 2000 },
        "output": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agent", "action", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/leads/{leadId}": {
      "schema": "Lead",
      "description": "Leads subcollection per user"
    },
    "/users/{userId}/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Activity logs collection per user"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Global activity logs collection"
    }
  }
}
