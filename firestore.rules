rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 255 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 255;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['userId']) &&
        data.userId is string && data.userId.size() <= 128 &&
        (!data.keys().hasAll(['name']) || (data.name is string && data.name.size() <= 255)) &&
        (!data.keys().hasAll(['company']) || (data.company is string && data.company.size() <= 255)) &&
        (!data.keys().hasAll(['status']) || (data.status is string && data.status.size() <= 64)) &&
        (!data.keys().hasAll(['message']) || (data.message is string && data.message.size() <= 5000));
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['agent', 'action', 'status']) &&
        data.agent is string && data.agent.size() <= 128 &&
        data.action is string && data.action.size() <= 255 &&
        data.status is string && data.status.size() <= 64;
    }

    function isValidAutomationJob(data) {
      return data.keys().hasAll(['userId', 'campaignId', 'type', 'status']) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.campaignId is string && data.campaignId.size() > 0 && data.campaignId.size() <= 128 &&
        data.type is string && data.type.size() <= 64 &&
        data.status is string && data.status.size() <= 32;
    }

    // Mirror of the Postgres `automation_jobs` table. Postgres is the store of
    // record; these documents exist so a future live-UI stream has something to
    // subscribe to.
    //
    // Writes must be allowed. The backend mirrors through the *client* SDK
    // (`firebase/firestore` in firestoreLogService.js) — there is no
    // firebase-admin anywhere in this repository — so these rules apply to it
    // exactly as they do to a browser. A deny-all here silently fails every
    // mirror write. `create`/`update` are therefore open but validated, which is
    // the same shape as the top-level activity_logs rule below.
    //
    // Reads stay denied, and that is the deliberate part. Every read rule here
    // scopes on `request.auth.uid`, a Firebase Auth identity, but the dashboard
    // authenticates with the backend's own JWT — Firebase Auth is wired into
    // /client-portal only. There is no uid to scope on, so an owner-scoped read
    // would deny everything anyway, and an open read would expose every user's
    // jobs to everyone. The UI reads through GET /api/campaigns/jobs, where the
    // JWT enforces ownership.
    match /automationJobs/{jobId} {
      allow get, list: if false;
      allow create, update: if isValidId(jobId) && isValidAutomationJob(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.email == resource.data.email;
      allow delete: if isOwner(userId);

      match /leads/{leadId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(leadId) && isValidLead(request.resource.data) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidLead(request.resource.data) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /activity_logs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidActivityLog(request.resource.data);
        allow update: if isOwner(userId) && isValidActivityLog(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    match /activity_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) && isValidActivityLog(request.resource.data);
      allow update, delete: if isSignedIn();
    }
  }
}
