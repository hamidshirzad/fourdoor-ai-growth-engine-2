rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 255 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 255;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['userId']) &&
        data.userId is string && data.userId.size() <= 128 &&
        (!data.keys().hasAll(['name']) || (data.name is string && data.name.size() <= 255)) &&
        (!data.keys().hasAll(['company']) || (data.company is string && data.company.size() <= 255)) &&
        (!data.keys().hasAll(['status']) || (data.status is string && data.status.size() <= 64)) &&
        (!data.keys().hasAll(['message']) || (data.message is string && data.message.size() <= 5000));
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['agent', 'action', 'status']) &&
        data.agent is string && data.agent.size() <= 128 &&
        data.action is string && data.action.size() <= 255 &&
        data.status is string && data.status.size() <= 64;
    }

    // Mirror of the Postgres `automation_jobs` table. Postgres is the store of
    // record; these documents exist so the backend has somewhere to project
    // live job status.
    //
    // No client touches this collection, in either direction. The backend writes
    // through the **Admin SDK** (firestoreLogService.js), which authenticates as
    // a service account and bypasses these rules entirely — so denying everything
    // here costs the mirror nothing.
    //
    // Reads are denied rather than owner-scoped because there is no owner to
    // scope on. Every rule in this file keys on `request.auth.uid`, a Firebase
    // Auth identity, but the dashboard authenticates with the backend's own JWT
    // — Firebase Auth is wired into /client-portal only. An owner-scoped read
    // would deny everything anyway, and an open read would expose every user's
    // jobs to everyone. The UI reads through GET /api/campaigns/jobs, where the
    // JWT enforces ownership.
    match /automationJobs/{jobId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.email == resource.data.email;
      allow delete: if isOwner(userId);

      match /leads/{leadId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(leadId) && isValidLead(request.resource.data) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidLead(request.resource.data) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /activity_logs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidActivityLog(request.resource.data);
        allow update: if isOwner(userId) && isValidActivityLog(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Top-level activity log, written by the backend through the Admin SDK.
    //
    // This used to read `allow get, list: if true` with an unauthenticated
    // `create`, which made every user's agent activity world-readable and let
    // anyone forge entries. The browser relied on that open read to stream logs
    // directly; it now goes through GET /api/activity/logs instead, where the
    // JWT scopes the query to the caller.
    //
    // The per-user copy under /users/{userId}/activity_logs above stays
    // owner-scoped for the Firebase-authenticated /client-portal.
    match /activity_logs/{logId} {
      allow read, write: if false;
    }
  }
}
